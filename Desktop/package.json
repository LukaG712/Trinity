{
  "name": "troved-desktop",
  "productName": "Troved",
  "version": "1.0.0",
  "description": "Troved - personal wishlist (portable desktop app)",
  "main": "electron/main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable --x64",
    "build:installer": "electron-builder --win nsis --x64",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.troved.desktop",
    "productName": "Troved",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "../frontend/dist/**/*",
      "../server/index.mjs"
    ],
    "extraResources": [
      {
        "from": "../frontend/dist",
        "to": "frontend/dist"
      },
      {
        "from": "../server",
        "to": "server"
      }
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "asar": true,
    "nodeGypRebuild": false,
    "win": {
      "sign": null,
      "signAndEditExecutable": false,
      "signDlls": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Troved-Portable.${ext}"
    },
    "nsis": {
      "artifactName": "Troved-Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Troved"
    },
    "publish": null
  },
  "allowScripts": {
    "electron@28.3.3": true
  }
}